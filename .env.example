# Vigil credentials: names only, never values.
# The real file is ~/.config/vigil/env (mode 600) on the Mac mini.
# docs/runbook.md "Credentials" says what each one is, where to get it,
# and which phase first needs it.

# Claude: executor, reviewer, auditor, Haiku decider (phase 1)
ANTHROPIC_API_KEY=

# GitHub App "vigil-worker" (phase 1); the .pem sits beside the env file
VIGIL_GITHUB_APP_CLIENT_ID=
# absolute path to the .pem, normally /Users/<you>/.config/vigil/vigil-worker.pem
VIGIL_GITHUB_APP_KEY_PATH=

# Langfuse project keys, used by the OTel collector and headless init (phase 1)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Langfuse first-start login (phase 1)
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
# Langfuse internals, read only by compose.yaml (phase 1)
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_MINIO_PASSWORD=

# Jev decider on Cloudflare Workers AI (phase 1; Haiku covers until set)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# OpenRouter backend preset, and Jev's alternative route (phase 4, or earlier
# if you want it); never used for a private repo
OPENROUTER_API_KEY=

# Tower llama-server (phase 5); same value in the tower's /etc/vigil/llama.env
LLAMA_API_KEY=

# vigild API: admin (CLI, MCP, web UI), read-only metering (Hearth),
# and heartbeat-only (outside sessions shown on /sessions)
VIGIL_API_TOKEN=
VIGIL_METRICS_TOKEN=
VIGIL_HEARTBEAT_TOKEN=
