<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template. Replace the four __PLACEHOLDERS__ (see docs/runbook.md, "Run
     vigild under launchd"); keep the filled copy out of the repo. vigild reads
     its secrets from ~/.config/vigil/env itself; nothing secret lives here. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.vigil.vigild</string>
  <key>WorkingDirectory</key>
  <string>__REPO_CHECKOUT__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__UV_PATH__</string>
    <string>run</string>
    <string>--locked</string>
    <string>python</string>
    <string>-m</string>
    <string>vigild</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/vigil-data/logs/vigild.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/vigil-data/logs/vigild.log</string>
</dict>
</plist>
